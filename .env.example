# --- Discord ---
# Bot token from the Discord Developer Portal (Bot tab)
DISCORD_TOKEN=

# --- Database (Supabase Postgres) ---
# Use Supabase's SESSION POOLER connection string (port 5432), not the
# transaction pooler (6543) and not the direct db.<ref>.supabase.co host.
#   - The session pooler is dual-stack (works on Railway's IPv4 network),
#     where Supabase's "direct connection" host is IPv6-only.
#   - This bot is a single long-running process, not serverless, so it
#     doesn't need transaction-mode connection recycling.
# Find it in: Supabase Dashboard > Project Settings > Database > Connection
# string > "Session pooler".
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Leave unset for Supabase (SSL on by default, with a valid CA-signed
# cert). If you're pointing this at a local/self-hosted Postgres that isn't
# configured for SSL at all, set PGSSL=false or the connection will fail.
# PGSSL=false
# PGSSL_REJECT_UNAUTHORIZED=false
